---

---

<div
	data-scenario="dashboard"
	class="absolute inset-0 p-6 flex flex-col justify-center opacity-0 transition-opacity duration-400 pointer-events-none [&.active]:opacity-100 [&.active]:pointer-events-auto"
>
	<div class="flex gap-3">
		<div
			class="flex-1 flex flex-col gap-2 p-3.5 rounded-xl bg-surface border border-border"
		>
			<div class="relative w-13 h-13 shrink-0">
				<svg
					data-dash-slot="0"
					data-sarmal-svg
					class="absolute inset-0 w-full h-full"></svg>
				<canvas
					data-dash-canvas="0"
					data-sarmal-canvas
					class="absolute inset-0 w-full h-full"
					width="52"
					height="52"></canvas>
			</div>
			<div class="font-ui text-[10px] tracking-[0.04em] text-muted">
				Refinement Accuracy
			</div>
			<div
				data-dash-val="0"
				class="transition-colors duration-500 font-heading text-xl font-semibold leading-none text-muted tracking-[-0.02em]"
			>
				—
			</div>
		</div>
		<div
			class="flex-1 flex flex-col gap-2 p-3.5 rounded-xl bg-surface border border-border"
		>
			<div class="relative w-13 h-13 shrink-0">
				<svg
					data-dash-slot="1"
					data-sarmal-svg
					class="absolute inset-0 w-full h-full"></svg>
				<canvas
					data-dash-canvas="1"
					data-sarmal-canvas
					class="absolute inset-0 w-full h-full"
					width="52"
					height="52"></canvas>
			</div>
			<div class="font-ui text-[10px] tracking-[0.04em] text-muted">
				Tempers Balanced
			</div>
			<div
				data-dash-val="1"
				class="transition-colors duration-500 font-heading text-xl font-semibold leading-none text-muted tracking-[-0.02em]"
			>
				—
			</div>
		</div>
	</div>
</div>

<script>
	import { createSarmalSVG, createSarmalDotMatrix, curves } from "@sarmal/core";
	import type { DemoScenarioAPI } from "../../../lib/demo";

	type SVGInstance = ReturnType<typeof createSarmalSVG>;
	type DMInstance = ReturnType<typeof createSarmalDotMatrix>;

	const isDM = () =>
		document.documentElement.dataset.sarmalMode === "dotmatrix";

	function stopSVG(s: SVGInstance | null, slot: SVGSVGElement): null {
		s?.pause();
		slot.innerHTML = "";
		return null;
	}

	function stopDM(s: DMInstance | null, canvas: HTMLCanvasElement): null {
		s?.destroy();
		const ctx = canvas.getContext("2d");
		if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
		return null;
	}

	const DASH_ITEMS = [
		{
			slotSelector: "[data-dash-slot='0']",
			canvasSelector: "[data-dash-canvas='0']",
			valSelector: "[data-dash-val='0']",
			curve: curves.epitrochoid7,
			color: "#38bdf8",
			value: "98.4%",
		},
		{
			slotSelector: "[data-dash-slot='1']",
			canvasSelector: "[data-dash-canvas='1']",
			valSelector: "[data-dash-val='1']",
			curve: curves.rose5,
			color: "#4ade80",
			value: "2,847",
		},
	];

	function initDashboard(container: HTMLElement): DemoScenarioAPI {
		let dashSarmals: (SVGInstance | null)[] = [null, null];
		let dashDMs: (DMInstance | null)[] = [null, null];
		let dashGen = 0;
		let dashTimers: ReturnType<typeof setTimeout>[] = [];

		function cleanup() {
			dashGen++;
			dashTimers.forEach((t) => clearTimeout(t));
			dashTimers = [];
			DASH_ITEMS.forEach((item, i) => {
				const slot = container.querySelector(
					item.slotSelector,
				) as SVGSVGElement;
				const canvas = container.querySelector(
					item.canvasSelector,
				) as HTMLCanvasElement;
				const valEl = container.querySelector(item.valSelector) as HTMLElement;
				dashSarmals[i] = stopSVG(dashSarmals[i], slot);
				dashDMs[i] = stopDM(dashDMs[i], canvas);
				valEl.textContent = "—";
				valEl.classList.remove("text-foreground");
				valEl.classList.add("text-muted");
			});
		}

		function start(onDone: () => void) {
			cleanup();
			const gen = dashGen;

			DASH_ITEMS.forEach((item, i) => {
				if (isDM()) {
					const canvas = container.querySelector(
						item.canvasSelector,
					) as HTMLCanvasElement;
					dashDMs[i] = createSarmalDotMatrix(canvas, item.curve, {
						trailColor: item.color,
						trailLength: 80,
						cols: 12,
						rows: 12,
					});
				} else {
					const slot = container.querySelector(
						item.slotSelector,
					) as SVGSVGElement;
					dashSarmals[i] = createSarmalSVG(slot, item.curve, {
						trailColor: item.color,
						skeletonColor: "rgba(255,255,255,0.05)",
						headColor: item.color,
						headRadius: 2,
						trailLength: 80,
					});
				}
			});

			DASH_ITEMS.forEach((item, i) => {
				dashTimers.push(
					setTimeout(
						() => {
							if (dashGen !== gen) return;
							const slot = container.querySelector(
								item.slotSelector,
							) as SVGSVGElement;
							const canvas = container.querySelector(
								item.canvasSelector,
							) as HTMLCanvasElement;
							const valEl = container.querySelector(
								item.valSelector,
							) as HTMLElement;
							dashSarmals[i] = stopSVG(dashSarmals[i], slot);
							dashDMs[i] = stopDM(dashDMs[i], canvas);
							valEl.textContent = item.value;
							valEl.classList.remove("text-muted");
							valEl.classList.add("text-foreground");
							if (i === DASH_ITEMS.length - 1) onDone();
						},
						2200 + i * 450,
					),
				);
			});
		}

		return { start, cleanup };
	}

	const container = document.querySelector(
		'[data-scenario="dashboard"]',
	) as HTMLElement;
	if (container) {
		window.demoRegistry = window.demoRegistry || {};
		window.demoRegistry["dashboard"] = initDashboard(container);
	}
</script>
