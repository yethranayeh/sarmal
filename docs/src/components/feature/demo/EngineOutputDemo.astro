---
const id = `eng-${Math.random().toString(36).slice(2, 8)}`;
---

<div
	id={id}
	data-engine-output-demo
	class="content-auto max-w-sm rounded-lg overflow-hidden border border-border"
>
	<div class="flex flex-col md:flex-row">
		<div class="flex-1 min-w-0 bg-surface flex justify-center">
			<div class="relative size-60">
				<svg data-eng-view data-sarmal-svg class="absolute inset-0 size-full"
				></svg>
				<canvas
					data-eng-view-dm
					data-sarmal-canvas
					class="absolute inset-0 size-full"
					width="240"
					height="240"></canvas>
			</div>
		</div>
		<div
			class="w-full md:w-36 shrink-0 border-t border-l-0 md:border-t-0 md:border-l border-border bg-surface-raised flex flex-col justify-center md:justify-start py-2 px-4 md:py-4 md:gap-3"
		>
			<div class="font-mono text-xs text-foreground leading-[1.4]">
				engine.tick(dt)
			</div>
			<div
				class="font-mono text-[0.72rem] leading-loose flex md:flex-col gap-4 md:gap-0"
			>
				<div>
					<span class="text-muted">x: </span><span
						data-coord-x
						class="text-primary">0.000</span
					>
				</div>
				<div>
					<span class="text-muted">y: </span><span
						data-coord-y
						class="text-primary">0.000</span
					>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import type { Point, CurveDef } from "@sarmal/core";
	import {
		createSarmalSVG,
		createSarmalDotMatrix,
		curves,
		palettes,
	} from "@sarmal/core";

	const wrapper = document.querySelector(
		"[data-engine-output-demo]",
	) as HTMLElement;
	const view = wrapper.querySelector<SVGSVGElement>("[data-eng-view]")!;
	const dmView =
		wrapper.querySelector<HTMLCanvasElement>("[data-eng-view-dm]")!;
	const coordX = wrapper.querySelector<HTMLElement>("[data-coord-x]")!;
	const coordY = wrapper.querySelector<HTMLElement>("[data-coord-y]")!;

	const isDM = () =>
		document.documentElement.dataset.sarmalMode === "dotmatrix";

	// Wrapped curve: captures the latest head position on every fn() call.
	// The engine calls fn() once per tick, so lastHead always reflects the current head.
	let lastHead: Point = { x: 0, y: 0 };
	const trackedCurve: CurveDef = {
		...curves.astroid,
		fn(phase, elapsed, params) {
			const pt = curves.astroid.fn(phase, elapsed, params);
			lastHead = pt;
			return pt;
		},
	};

	const sarmal = createSarmalSVG(view, trackedCurve, {
		trailColor: palettes.bard,
		trailStyle: "gradient-animated",
		skeletonColor: "#c8c4be",
		headRadius: 1,
		autoStart: !isDM(),
	});
	sarmal.setSpeed(0.3);

	const dmSarmal = createSarmalDotMatrix(dmView, trackedCurve, {
		trailColor: palettes.bard,
		trailStyle: "gradient-animated",
		cols: 20,
		rows: 20,
		autoStart: isDM(),
	});
	// Dot Matrix runs at the curve's natural speed
	// setSpeed(0.3) would make the short trail (60 pts) nearly static on the 20x20 grid

	requestAnimationFrame(function update() {
		coordX.textContent = lastHead.x.toFixed(3);
		coordY.textContent = lastHead.y.toFixed(3);
		requestAnimationFrame(update);
	});

	new MutationObserver(() => {
		if (isDM()) {
			sarmal.pause();
			dmSarmal.play();
		} else {
			dmSarmal.pause();
			sarmal.play();
		}
	}).observe(document.documentElement, {
		attributeFilter: ["data-sarmal-mode"],
	});
</script>
