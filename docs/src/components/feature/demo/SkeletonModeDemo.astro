---
const id = `skel-${Math.random().toString(36).slice(2, 8)}`;
---

<div id={id} class="content-auto max-w-xl overflow-hidden">
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		{
			[
				{ name: "static", desc: "drifts over time" },
				{ name: "live", desc: "always matches" },
			].map((mode) => (
				<div class="flex flex-col rounded-lg overflow-hidden border border-border">
					<div class="flex items-center justify-between px-3 py-[0.35rem] border-b border-border bg-(--color-surface-raised)">
						<span class="font-ui text-[0.63rem] text-foreground">
							skeleton: <span class="text-accent">'{mode.name}'</span>
						</span>
						<span class="font-ui text-[0.57rem] text-muted">{mode.desc}</span>
					</div>
					<div class="relative h-50">
						<svg
							id={`demo-skeleton-${mode.name}`}
							data-sarmal-svg
							class="skel-static-view absolute inset-0 w-full h-full bg-surface"
						/>
						<canvas
							id={`demo-skeleton-${mode.name}-dm`}
							data-sarmal-canvas
							class="absolute inset-0 w-full h-full bg-surface"
						/>
					</div>
				</div>
			))
		}
	</div>
</div>

<script>
	import {
		createSarmalSVG,
		createSarmalDotMatrix,
		lame,
		palettes,
	} from "@sarmal/core";
	const modes = ["static", "live"] as const;

	const isDM = () =>
		document.documentElement.dataset.sarmalMode === "dotmatrix";

	const instances: Array<{
		svg: ReturnType<typeof createSarmalSVG>;
		dm: ReturnType<typeof createSarmalDotMatrix>;
	}> = [];

	for (const mode of modes) {
		const svg = document.querySelector<SVGSVGElement>(
			`#demo-skeleton-${mode}`,
		)!;
		const dmCanvas = document.querySelector<HTMLCanvasElement>(
			`#demo-skeleton-${mode}-dm`,
		)!;

		const svgInst = createSarmalSVG(
			svg,
			{ ...lame, skeleton: mode },
			{
				trailColor: palettes.sunset,
				trailStyle: "gradient-static",
				skeletonColor: "#c8c4be",
				trailLength: 300,
				autoStart: !isDM(),
			},
		);

		dmCanvas.width = dmCanvas.offsetWidth || 200;
		dmCanvas.height = dmCanvas.offsetHeight || 200;

		const dmInst = createSarmalDotMatrix(
			dmCanvas,
			{ ...lame },
			{
				trailColor: palettes.sunset,
				trailStyle: "gradient-static",
				trailLength: 300,
				cols: 28,
				rows: 28,
				autoStart: isDM(),
			},
		);

		instances.push({ svg: svgInst, dm: dmInst });
	}

	new MutationObserver(() => {
		for (const { svg, dm } of instances) {
			if (isDM()) {
				svg.pause();
				dm.play();
			} else {
				dm.pause();
				svg.play();
			}
		}
	}).observe(document.documentElement, {
		attributeFilter: ["data-sarmal-mode"],
	});
</script>
