---
import { palettes } from "@sarmal/core";
import SectionLabel from "./SectionLabel.astro";

const entries = Object.entries(palettes);
---

<div
	class="my-6 overflow-hidden rounded-xl border border-border bg-surface-raised"
>
	<div class="border-b border-border-subtle bg-background px-4 py-3">
		<SectionLabel label="Built-in Palettes" />
	</div>

	<div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2">
		{
			entries.map(([name, colors]) => (
				<div class="space-y-2.5 rounded-lg border border-border-subtle bg-surface p-3">
					<div class="font-ui text-xs font-medium text-foreground capitalize">
						{name}
					</div>
					<div class="relative h-4.5 w-full">
						<div
							data-palette-normal
							class="absolute inset-0 rounded-md"
							style={`background-image: linear-gradient(to right, ${colors.join(", ")})`}
						/>
						<div
							data-palette-dots
							class="absolute inset-0 rounded-md"
							style={`background-image: linear-gradient(to right, ${colors.join(", ")})`}
						/>
					</div>
					<div class="flex gap-1.5">
						{colors.map((color) => (
							<div class="flex flex-1 flex-col items-center">
								<div class="relative h-6 w-full">
									<div
										data-palette-normal
										class="absolute inset-0 rounded"
										style={`background-color: ${color}`}
									/>
									<div
										data-palette-dots
										class="absolute inset-0"
										style={`background-color: ${color}`}
									/>
								</div>
								<span class="mt-0.5 block font-mono text-[10px] uppercase text-muted-gray">
									{color}
								</span>
							</div>
						))}
					</div>
				</div>
			))
		}
	</div>
</div>

<style is:global>
	[data-palette-normal],
	[data-palette-dots] {
		transition: opacity 300ms;
	}

	[data-palette-dots] {
		mask-image: radial-gradient(circle, black 38%, transparent 39%);
		mask-size: 6px 6px;
		mask-repeat: repeat;
		opacity: 0;
	}

	html[data-sarmal-mode="dotmatrix"] [data-palette-normal] {
		opacity: 0;
	}

	html[data-sarmal-mode="dotmatrix"] [data-palette-dots] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-palette-normal],
		[data-palette-dots] {
			transition: none;
		}
	}
</style>
