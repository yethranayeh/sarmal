<div class="not-prose">
	<canvas id="intro-canvas" width={200} height={200}></canvas>
</div>

<script>
	import { createSarmalDotMatrix, curves, palettes } from "@sarmal/core";
	const canvas = document.getElementById("intro-canvas") as HTMLCanvasElement;

	const inst = createSarmalDotMatrix(canvas, curves.lissajous43, {
		cols: 32,
		rows: 32,
		trailColor: palettes.sunset,
		trailStyle: "gradient-static",
		skeletonColor: "#3a3b37",
		gridColor: "transparent",
		autoStart: false,
	});

	const observer = new IntersectionObserver(
		(entries) => {
			if (entries[0]?.isIntersecting) {
				inst.play();
			} else {
				inst.pause();
			}
		},
		{ threshold: 0.1 },
	);

	observer.observe(canvas);

	canvas.addEventListener("mouseenter", () => {
		inst.setSpeedOver(0.3, 400).catch(() => {});
	});
	canvas.addEventListener("mouseleave", () => {
		inst.setSpeedOver(1.0, 500).catch(() => {});
	});
</script>
